# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Flutter 데모 빌드 산출물. 커밋하지 않는다 — 패키지당 수 MB 라 히스토리가 부푼다.
# 배포는 CI 러너가 scripts/ci-build-demos.mjs 로 만들어 배포물에만 넣는다.
/public/demo/

# CI 가 데모 캐시 신선도를 판단하는 데 쓴다. 러너에서 만들어진다.
.demo-versions.json
